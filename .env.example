# Single local configuration file. Copy to .env and replace both passwords.
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=18080
FRONTEND_URL=http://127.0.0.1:18080
VITE_API_MODE=mock
VITE_API_BASE_URL=
JAVA_API_UPSTREAM=http://host.docker.internal:8080
RETRIEVAL_SERVICE_HOST=127.0.0.1
RETRIEVAL_SERVICE_PORT=8001

POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=guguwiki
POSTGRES_USER=guguwiki
POSTGRES_PASSWORD=replace-with-a-long-local-password

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_INTERNAL_HOST=redis
REDIS_INTERNAL_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-another-long-local-password

# AdminSeedTest uses three explicit process environment variables when run manually:
# GUGUWIKI_SEED_ADMIN=true
# GUGUWIKI_SEED_ADMIN_EMAIL=admin@example.com
# GUGUWIKI_SEED_ADMIN_PASSWORD=<at-least-8-characters>
